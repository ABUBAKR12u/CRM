# Sessiya imzosi uchun maxfiy kalit (kamida 32 belgi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Python backend (../backend) manzili. Faqat Next.js serveri murojaat qiladi, brauzer emas.
BACKEND_URL=http://127.0.0.1:8000

# Login sahifasida demo hisoblar ro'yxati. Dev'da doim ko'rinadi; production build'da faqat "true" bo'lsa.
# Ochiq internetga chiqariladigan muhitda yoqmang.
SHOW_DEMO_ACCOUNTS=false
